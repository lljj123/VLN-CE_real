{
  "instruction": "Go straight down the hallway. At the end of the hallway, turn left into the office and stop in front of the chair.",
  "checkpoint": "data/checkpoints/CMA_PM_DA_Aug_robot.pth",
  "topics": {
    "rgb": "/camera/rgb/image_raw",
    "depth_raw": "/camera/depth_registered/image_raw",
    "depth_filled": "/camera/depth_registered/image_filled",
    "action": "/vln/action",
    "action_result": "/vln/action_result",
    "inference_metrics": "/vln/inference_metrics",
    "cmd_vel": "/cmd_vel_mux/input/teleop",
    "odom": "/odom"
  },
  "inference": {
    "max_actions": 0,
    "min_action_interval_seconds": 0.0,
    "instruction_length": 200,
    "force_cpu": false,
    "sample_actions": false,
    "publish_actions": true,
    "wait_for_action_result": true,
    "action_result_timeout_seconds": 8.0,
    "keep_running_after_stop": false
  },
  "synchronization": {
    "slop_seconds": 0.1,
    "queue_size": 20,
    "input_timeout_seconds": 30.0,
    "exit_on_input_timeout": false
  },
  "startup": {
    "image_timeout_seconds": 20.0,
    "action_subscriber_wait_seconds": 5.0
  },
  "monitor": {
    "gui": true,
    "output_directory": "~/.ros/vln_action_metrics",
    "history_size": 100
  },
  "depth": {
    "min_meters": 0.0,
    "max_meters": 10.0,
    "log_every_frames": 0
  }
}
